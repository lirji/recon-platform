server {
    listen 8088;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-store" always;
        return 200 'ok';
    }

    location /recon {
        # Docker 内嵌 DNS (127.0.0.11): 让 nginx 运行期按 TTL 重解析 backend 主机名。
        # 静态 proxy_pass 只在 worker 启动时解析一次并缓存 IP —— 后端容器重建换 IP 后会一直 502。
        # 用「变量 upstream」才会触发逐请求重解析(配合 $request_uri 保留完整路径与查询串)。
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $recon_upstream ${RECON_API_URL};
        proxy_pass $recon_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
