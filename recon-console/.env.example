# Vite 开发代理的后端地址；浏览器始终请求同源 /recon。
VITE_RECON_API_TARGET=http://localhost:8080

# A1 认证鉴权。默认 dev:本地免 Casdoor(后端 DevSecurityConfig permitAll,/recon/auth/me 返回全权限开发身份)。
# 联调/生产置 oidc:走 Casdoor 授权码 + PKCE(值由 auth-platform/deploy/recon-platform-provision.sh 产出)。
VITE_AUTH_MODE=dev
VITE_CASDOOR_SERVER_URL=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=ragshared0client00000001-org-recon-platform
VITE_CASDOOR_ORGANIZATION=recon-platform
VITE_CASDOOR_APP_NAME=rag-shared
VITE_CASDOOR_SCOPE=openid profile offline_access
