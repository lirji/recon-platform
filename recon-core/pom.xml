<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lrj.recon</groupId>
        <artifactId>recon-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>recon-core</artifactId>
    <name>recon-core</name>
    <description>对账领域内核: 值对象/枚举 + 领域服务 (SortMerge/Classifier/Conservation) + 四插件 SPI。纯 Java 零框架, ArchUnit 门禁。</description>

    <!--
      纯领域内核: main 侧不允许任何框架依赖 (Spring/Batch/Drools/JDBC/CSV/Flowable/JPA)，
      由 ArchitectureTest 持续门禁。这里 main 依赖为空 (仅 JDK)。
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
