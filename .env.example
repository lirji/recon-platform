# 本机开发公共基础设施配置。复制为 .env 后替换密码；.env 已被 Git 忽略。
DEV_INFRA_NETWORK=dev-infra
RECON_DB_NAME=recon
RECON_FLOWABLE_DB_NAME=recon_flowable
RECON_DB_USER=recon
RECON_DB_PASSWORD=change-me-recon-db
RECON_UI_PORT=8088

# 统一链路追踪；完全关闭可设置 OTEL_SDK_DISABLED=true。
OTEL_EXPORTER_OTLP_ENDPOINT=http://infra-otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
