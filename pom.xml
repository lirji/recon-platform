<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 spring-boot-starter-parent 仅为拿依赖/插件管理基线 (junit5/assertj/surefire 版本对齐)。
         recon-core 本身零框架, 不引入任何 spring 运行时依赖。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lrj.recon</groupId>
    <artifactId>recon-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>recon-platform</name>
    <description>通用自动对账系统 (六边形分层, recon-core 纯领域内核)</description>

    <!-- 阶段一 MVP M0-M6 完整模块：纯领域内核 + DB/CSV 数据源 + 场景/处理链外圈 + Batch 组合根。 -->
    <modules>
        <module>recon-core</module>
        <module>recon-source-db</module>
        <module>recon-source-csv</module>
        <module>recon-scenario</module>
        <module>recon-handler</module>
        <module>recon-batch</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <commons-csv.version>1.14.1</commons-csv.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ArchUnit 不在 spring-boot BOM 中, 本平台统一版本 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- 平台内部模块统一版本 -->
            <dependency>
                <groupId>com.lrj.recon</groupId>
                <artifactId>recon-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.recon</groupId>
                <artifactId>recon-source-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.recon</groupId>
                <artifactId>recon-source-csv</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.recon</groupId>
                <artifactId>recon-scenario</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lrj.recon</groupId>
                <artifactId>recon-handler</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
