<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lrj.recon</groupId>
        <artifactId>recon-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>recon-batch</artifactId>
    <name>recon-batch</name>
    <description>Spring Boot 组合根: DB/CSV 源路由、Spring Batch 编排、JDBC/Flyway、REST、调度与 outbox 中继。</description>

    <dependencies>
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-source-db</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-source-csv</artifactId>
        </dependency>
        <!-- M4: 营销三方两段桥接场景装配 (SpineBridgeKeyExtractor + MarketingThreeWayScenario). -->
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-scenario</artifactId>
        </dependency>
        <!-- M5: 处理链 (LedgerHandler / ReversalSuggestionHandler / AlertHandler / FlowableTicketHandler). -->
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-handler</artifactId>
        </dependency>
        <!-- B2: Drools 判差策略层 (外圈)。org.kie/org.drools 封装在此模块内, 组合根只经其公开 SPI 装配。 -->
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-rules-drools</artifactId>
        </dependency>
        <!-- B5: Flowable 冲正审批工作流 (外圈)。org.flowable 封装在此模块内, 组合根只经其门面装配 (条件加载)。 -->
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-workflow-flowable</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- M5: REST 接口 (DiscrepancyController 发起 Run / 人工核销 / 报表查询). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- M2: 全工作区首次引入 Spring Batch (starter 带 spring-batch-core + JDBC).
             Boot batch autoconfig 提供 JobRepository/JobLauncher (元数据表 Flyway V2 建); 不用 @EnableBatchProcessing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>
        <!-- A1: OAuth2 Resource Server. 按 Casdoor 签发的 JWT 验签 (JWKS) + 角色授权.
             recon.auth.issuer-uri 空时 (本地/测试) 用占位解码器, 不触发网络, 无 token 请求由 filter 直接 401. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- A4: 可观测性. actuator 提供 health(liveness/readiness 探针)/info/metrics; micrometer prometheus 注册表
             暴露 /actuator/prometheus (含 Spring Batch 自动 spring.batch.* 计量 + 本平台 recon.job.* 自定义计量). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- A4: 结构化日志 (secure/prod profile 输出 JSON, 便于日志聚合); dev/测试保持默认可读控制台格式. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- A3: 生产可切 PostgreSQL —— PG 驱动 + Flyway 10 的 PG 模块提为 runtime (与 mysql-connector-j / h2 并列),
             令设计的 "MySQL8/PG 通用" 在生产成立 (DB_URL 指向 PG 即可), 不再仅限测试域. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A1: MockMvc 鉴权测试 (SecurityMockMvcRequestPostProcessors.jwt()). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- #6: 遗留② collation 真库验证 (MySQL8 + PostgreSQL). 版本由 spring-boot BOM 托管 (testcontainers 1.19.8).
             CollationRealDbIT 用 DockerClientFactory 守卫: 无 Docker 时 assumeTrue 优雅跳过, 不让 ./mvnw test 变红. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PG 驱动 (org.postgresql) 与 Flyway PG 模块 (flyway-database-postgresql) 已提为 runtime (见上, A3),
             测试域 (CollationRealDbIT / RealDbEndToEndIT) 与生产共用同一 runtime 依赖, 不再单列 test 作用域副本. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
