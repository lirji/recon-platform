<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lrj.recon</groupId>
        <artifactId>recon-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>recon-scenario</artifactId>
    <name>recon-scenario</name>
    <description>场景装配 (M4): SpineBridgeKeyExtractor (桥接双键抽取) + MarketingThreeWayScenario (营销三方两段责任链)。纯 Java 零框架, 只依赖 recon-core。</description>

    <!--
      外圈场景装配: 只依赖 recon-core (SPI/领域模型/分桶工具)。
      不引入 Spring / Batch / JDBC / Drools / CSV / Flowable —— 由 ArchitectureTest 门禁 (与 recon-core 纯度看齐)。
    -->
    <dependencies>
        <dependency>
            <groupId>com.lrj.recon</groupId>
            <artifactId>recon-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
